#!/bin/sh
# Pre-commit hook — the haptic channel must never drift.
#
# Runs before every commit:
#   1. python tools/haptic_timing.py          spec vs every generated consumer
#      (feel-tool block, firmware header, Python tables, doc tables, demo
#      fixture, ladder block). Fails the commit on any drift.
#   2. python -m ziv.wire + diff             the committed JSON Schemas match
#      ziv/wire.py. A contract change without a schema regeneration would
#      leave the client and the console typed against a stale wire.
#   3. python conformance/run.py --check     the reference renderer's golden
#      timelines are in sync with the renderer itself.
#   4. python firmware/haptic_out/run_tests.py  bench suite against the mock
#      DRV2605L. Skipped when no host C compiler is installed (exit 2); a
#      real failure (exit 1) blocks the commit.
#
# Install once — the script is committed, no framework needed:
#     git config core.hooksPath hooks
#
# Hooks run with the worktree root as cwd, so the relative paths below are
# correct from any subdirectory of the repo.
set -u

# Prefer the project venv (.venv) when present: it has the package installed
# and, on machines without a host gcc, the ziglang compiler for the bench.
PY=python
if [ -x .venv/bin/python ]; then PY=.venv/bin/python
elif [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python.exe
elif command -v "$PY" >/dev/null 2>&1; then :; else PY=python3; fi

fail=0

echo "pre-commit: haptic timing verify..."
if ! "$PY" tools/haptic_timing.py; then
    echo "  FAIL: timing spec and generated consumers disagree."
    echo "  Run: $PY tools/haptic_timing.py --write"
    echo "  and commit the regenerated files together."
    fail=1
fi

echo "pre-commit: wire schemas..."
tmp="$(mktemp -d 2>/dev/null || mktemp -d -t ziv-schema)"
if "$PY" -m ziv.wire "$tmp" >/dev/null 2>&1 && diff -rq "$tmp" schema >/dev/null; then
    echo "  schemas in sync."
else
    echo "  FAIL: schema/ does not match ziv/wire.py."
    echo "  Run: $PY -m ziv.wire schema/   (then: cd console && npm run gen:types)"
    fail=1
fi
rm -rf "$tmp"

echo "pre-commit: conformance oracle..."
if ! "$PY" conformance/run.py --check >/dev/null; then
    echo "  FAIL: conformance/expected drifts from the reference renderer."
    echo "  Run: $PY conformance/run.py --write"
    fail=1
fi

echo "pre-commit: haptic_out bench suite..."
"$PY" firmware/haptic_out/run_tests.py >/dev/null
bench=$?
if [ "$bench" = "1" ]; then
    echo "  FAIL: haptic_out bench suite failed."
    fail=1
elif [ "$bench" = "2" ]; then
    echo "  (skipped — no host C compiler; install one to run the bench suite)"
fi

if [ "$fail" = "0" ]; then
    echo "pre-commit: spec, schemas, oracle and bench in sync."
    exit 0
fi
echo "pre-commit: FAILED — commit blocked."
exit 1
