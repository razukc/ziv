menu "Ziv band"

    config ZIV_BAND_HAPTIC_MOCK
        bool "Haptic bus: the bench mock DRV2605 (no I2C) — QEMU and motor-less boards"
        default y
        help
            y: the sequencer drives firmware/haptic_out/mock_drv2605.c — the
            same bus the bench suite and the rung-1 QEMU app use.  No I2C
            traffic, so the image boots under QEMU and on a bare devkit.
            n: the real driver/i2c_master bus to the TCA9548A mux and the six
            DRV2605L (drv2605_i2c_esp32.c) — the hardware bring-up setting
            (HARDWARE_BRINGUP.md).

    config ZIV_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        help
            Empty (the default) leaves the radio off: app_main logs that
            Wi-Fi is unavailable and the transport stays offline, backing
            off.  That is the QEMU boot (no radio there) and the state of an
            unconfigured board.  Set it in menuconfig, never in a committed
            sdkconfig.defaults.

    config ZIV_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config ZIV_RELAY_URI
        string "Relay websocket URI"
        default "wss://relay.example.invalid/ws"
        help
            The device socket (architecture §6).  TLS off loopback; the
            device key travels in the first frame (hello), never here.

    config ZIV_DEVICE_KEY
        string "Device key"
        default ""
        help
            Issued once by the console's enrollment (16..128 chars).  Sent
            as the first frame; stored only in this config.

    config ZIV_PROFILE_SINGLE_ACTUATOR
        bool "Render with the single_actuator profile (one motor, six slots)"
        default n
        help
            The band is six_actuator by default.  Select for a one-motor
            build; the relay must have enrolled the device with the same
            profile.

    config ZIV_I2C_PORT
        int "I2C port"
        depends on !ZIV_BAND_HAPTIC_MOCK
        default 0

    config ZIV_I2C_SDA_GPIO
        int "I2C SDA GPIO"
        depends on !ZIV_BAND_HAPTIC_MOCK
        default 8

    config ZIV_I2C_SCL_GPIO
        int "I2C SCL GPIO"
        depends on !ZIV_BAND_HAPTIC_MOCK
        default 9

    config ZIV_I2C_HZ
        int "I2C clock (Hz)"
        depends on !ZIV_BAND_HAPTIC_MOCK
        default 100000
        help
            100 kHz to start; 400 kHz if cell edges smear (HARDWARE_BRINGUP.md
            §4 stage C).

endmenu
