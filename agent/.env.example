# The Ziv relay reads all of these with sane defaults — the server runs with
# none of them set (no model, no relay token). Set them when wiring the real
# model or locking the relay down.

# --- Nebius Token Factory: the agent path -------------------------------------
# One key enables the demo's model: a reminder you schedule as an *intent* is
# composed by Nemotron at fire time, and the phone spells the line it wrote
# (the wire log says source: text_live). Without a key the promise still
# fires, verbatim, labelled text_echo — so the log never claims a model ran
# when none did.
#
# The default model id below is a real NVIDIA open model the account serves.
# Do not copy an id off a model card: check your own list first —
#   curl -s $NEBIUS_BASE_URL/models -H "Authorization: Bearer $NEBIUS_API_KEY"
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
ZIV_TEXT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# The audio seam is opt-in and off by default: it needs an endpoint that
# accepts an audio input part. Leave ZIV_OMNI_MODEL empty unless you have
# one; /inject/audio answers 503 rather than guessing at a model id.

# --- Relay behavior ----------------------------------------------------------
ZIV_PORT=8787
# Paces a turn's working ticks when no model call is in flight. It is the
# offline stand-in for a real round-trip, not the demo's model.
ZIV_FAKE_MODEL_SECONDS=3.0
ZIV_RELAY_TOKEN=