NEBIUS_API_KEY=your_nebius_token_factory_api_key_here

# Optional: Upstash Redis REST credentials. When both are set, composed
# pipelines are stored in Redis so share links work across server instances
# and survive restarts. Without them the server falls back to a local
# agent/pipeline_store.json file.
# Get these from https://console.upstash.com (REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
