# The Ziv relay reads all of these with sane defaults — the server runs with
# none of them set (fake model, no relay token). Set them when wiring the
# real model / locking the relay down.

# Nebius Token Factory (the real on-device model path)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://tokenfactory.nebius.com/v1
ZIV_OMNI_MODEL=nvidia/Nemotron-3-Nano-Omni

# Relay behavior
ZIV_PORT=8787
ZIV_FAKE_MODEL_SECONDS=3.0
ZIV_RELAY_TOKEN=
