          "title": "Tail",
          "type": "string"
        }
      },
      "required": [
        "mark",
        "tail"
      ],
      "title": "Prefix",
      "type": "object"
    },
    "Source": {
      "description": "How the words were produced. ``live`` only when a model actually ran.",
      "enum": [
        "sender",
        "echo",
        "live"
      ],
      "title": "Source",
      "type": "string"
    }
  },
