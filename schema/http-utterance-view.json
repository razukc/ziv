        "queue_full",
        "over_budget",
        "unencodable",
        "expired",
        "spec_mismatch",
        "body_timeout",
        "hidden",
        "muted",
        "device_gone",
        "failover",
        "compose_failed",
        "cancelled_by_sender",
        "cancelled_by_wearer",
        "unauthorized",
        "bad_request",
        "rate_limited",
        "not_found",
        "conflict"
      ],
      "title": "Reason",
      "type": "string"
    },
    "Source": {
      "description": "How the words were produced. ``live`` only when a model actually ran.",
      "enum": [
        "sender",
        "echo",
        "live"
      ],
      "title": "Source",
      "type": "string"
    },
    "State": {
      "description": "Outbox states (docs/ARCHITECTURE.md \u00a74.1).",
      "enum": [
        "pending",
        "sent",
        "playing",
        "played",
        "failed",
        "expired",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a sender sees about an utterance: the id, its state, the exact words\nthat will be felt, and the budget it was measured against.",
  "properties": {
